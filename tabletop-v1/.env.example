# PostgreSQL (en Vercel: cadena de Neon/Vercel Postgres)
DATABASE_URL="postgresql://tabletop:tabletop_dev@127.0.0.1:5432/tabletop"
# Secreto para firmar sesiones y tokens de sala (generar uno largo y aleatorio)
